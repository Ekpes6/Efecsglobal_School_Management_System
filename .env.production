# ============================================================
# EduManage NG — PRODUCTION Environment Variables
# Rename this file to .env on your VPS
# NEVER commit .env to git
# ============================================================

# MySQL — use a strong, unique password
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_db_password_32chars
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_strong_db_password_32chars

# JWT Secret — must be at least 64 hex characters
# Generate one with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# Paystack (live key from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME

# SMTP (example uses Gmail App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=CHANGE_ME_gmail_app_password

# Termii SMS (https://termii.com — get API key from dashboard)
TERMII_API_KEY=CHANGE_ME_termii_api_key
